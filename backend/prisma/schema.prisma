// Educar para Transformar — Campus virtual
// Schema con auth, calificaciones, vínculo padre-hijo, asistencia,
// notificaciones, foros y planes de estudio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ESTUDIANTE
  DOCENTE
  PADRE
  ADMIN
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  TARDE
  JUSTIFICADO
}

enum ModerationStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoAlumno {
  ACTIVO
  INACTIVO
  EGRESADO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

// ---- Estructura académica (Módulo Alumnos / Profesores / Administración) ----

model NivelEducativo {
  id     Int    @id @default(autoincrement())
  nombre String @unique // Inicial | Primario | Secundario

  cursos        Curso[]
  gruposDeporte GrupoDeporte[]
}

model Curso {
  id      Int            @id @default(autoincrement())
  nombre  String
  nivelId Int
  nivel   NivelEducativo @relation(fields: [nivelId], references: [id], onDelete: Restrict)

  alumnos       User[]
  materiaCursos MateriaCurso[]

  @@unique([nombre, nivelId])
  @@index([nivelId])
}

model Materia {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  materiaCursos MateriaCurso[]
}

// Asignación Profesor–Materia–Curso: una materia puede dictarse en
// distintos cursos, y en cada curso puede estar a cargo de un profesor
// distinto.
model MateriaCurso {
  id        Int      @id @default(autoincrement())
  materiaId Int
  materia   Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  cursoId   Int
  curso     Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  docenteId Int
  docente   User     @relation("DocenteMateriaCurso", fields: [docenteId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([materiaId, cursoId, docenteId])
  @@index([cursoId])
  @@index([docenteId])
}

model User {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique
  email     String   @unique
  dni       String   @unique
  password  String
  role      Role
  nombre    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Ficha de alumno (RF-9) — solo se completan para role = ESTUDIANTE
  legajo          String?       @unique
  apellido        String?
  fechaNacimiento DateTime?     @db.Date
  domicilio       String?
  telefono        String?
  estado          EstadoAlumno?
  cursoId         Int?
  curso           Curso?        @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  notasRecibidas Grade[]             @relation("EstudianteGrades")
  notasDadas     Grade[]             @relation("DocenteGrades")
  hijos          ParentStudentLink[] @relation("PadreLinks")
  padres         ParentStudentLink[] @relation("EstudianteLinks")

  asistencias           Attendance[]
  notificaciones        Notification[]
  planesDeEstudio       StudyPlan[]
  forumPosts            ForumPost[]
  forumReplies          ForumReply[]
  materiasDictadas      MateriaCurso[] @relation("DocenteMateriaCurso")
  gruposDeporteDictados GrupoDeporte[] @relation("DocenteGrupoDeporte")

  inscripcionesDeporte   InscripcionDeporte[]   @relation("InscripcionesDeporte")
  inscripcionTransporte  InscripcionTransporte?
  inscripcionComedor     InscripcionComedor?

  @@index([role])
  @@index([cursoId])
}

model Grade {
  id           Int      @id @default(autoincrement())
  estudianteId Int
  estudiante   User     @relation("EstudianteGrades", fields: [estudianteId], references: [id], onDelete: Cascade)
  docenteId    Int
  docente      User     @relation("DocenteGrades", fields: [docenteId], references: [id], onDelete: Restrict)
  materia      String
  instancia    String
  nota         Int
  fecha        DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([estudianteId])
  @@index([docenteId])
}

model ParentStudentLink {
  id           Int  @id @default(autoincrement())
  padreId      Int
  padre        User @relation("PadreLinks", fields: [padreId], references: [id], onDelete: Cascade)
  estudianteId Int
  estudiante   User @relation("EstudianteLinks", fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([padreId, estudianteId])
  @@index([estudianteId])
}

model Attendance {
  id           Int              @id @default(autoincrement())
  estudianteId Int
  estudiante   User             @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  fecha        DateTime         @db.Date
  status       AttendanceStatus
  materia      String?
  observacion  String?
  createdAt    DateTime         @default(now())

  @@unique([estudianteId, fecha, materia])
  @@index([estudianteId])
  @@index([fecha])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo    String
  contenido String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ForumPost {
  id        Int      @id @default(autoincrement())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  materia   String
  titulo    String
  contenido String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  replies ForumReply[]

  @@index([materia])
  @@index([createdAt])
}

model ForumReply {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  contenido String
  createdAt DateTime  @default(now())

  @@index([postId])
}

model Inscription {
  id               Int              @id @default(autoincrement())
  nombreTutor      String
  emailTutor       String
  telefonoTutor    String
  nombreEstudiante String
  nivel            String
  curso            String
  mensaje          String?
  status           ModerationStatus @default(PENDIENTE)
  notaAdmin        String?
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?

  @@index([status])
  @@index([createdAt])
}

model Opinion {
  id         Int              @id @default(autoincrement())
  nombre     String?
  rol        String
  texto      String
  rating     Int
  status     ModerationStatus @default(PENDIENTE)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model EmploymentApplication {
  id         Int              @id @default(autoincrement())
  nombre     String
  email      String
  puesto     String
  cvUrl      String?
  status     ModerationStatus @default(PENDIENTE)
  notaAdmin  String?
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model StudyPlan {
  id         Int      @id @default(autoincrement())
  docenteId  Int
  docente    User     @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  materia    String
  titulo     String
  objetivos  String
  contenidos String
  fileUrl    String?
  createdAt  DateTime @default(now())

  @@index([materia])
}

// ---- Deportes / Transporte / Comedor (RF-14, RF-15) ----

model Deporte {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  grupos        GrupoDeporte[]
  inscripciones InscripcionDeporte[]
}

// Grupo de deporte: deporte + nivel + día + horario + profesor responsable
// (RF-14). El horario se modela con campos estructurados (no texto libre)
// porque es parte de la clave única y RF-21 exige más adelante detectar
// solapamiento horario entre los deportes de un mismo alumno, algo
// inviable de calcular comparando strings arbitrarios.
model GrupoDeporte {
  id         Int            @id @default(autoincrement())
  deporteId  Int
  deporte    Deporte        @relation(fields: [deporteId], references: [id], onDelete: Restrict)
  nivelId    Int
  nivel      NivelEducativo @relation(fields: [nivelId], references: [id], onDelete: Restrict)
  diaSemana  DiaSemana
  horaInicio DateTime       @db.Time
  horaFin    DateTime       @db.Time
  docenteId  Int
  docente    User           @relation("DocenteGrupoDeporte", fields: [docenteId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now())

  inscripciones InscripcionDeporte[]

  @@unique([deporteId, nivelId, diaSemana, horaInicio, horaFin])
  @@index([nivelId])
  @@index([docenteId])
}

// Catálogo plano: sin relación a nivel/curso/profesor (el TP no la pide) y
// sin ninguna regla de negocio de solapamiento horario sobre este modelo.
// Salida y regreso son dos eventos distintos del día (no un rango continuo
// como GrupoDeporte), por eso los campos se llaman horaSalida/horaRegreso
// y no horaInicio/horaFin.
model RecorridoTransporte {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  horaSalida  DateTime @db.Time
  horaRegreso DateTime @db.Time
  createdAt   DateTime @default(now())

  inscripciones InscripcionTransporte[]
}

// Catálogo plano, mismo criterio que RecorridoTransporte. Acá sí es un
// único bloque de tiempo (como GrupoDeporte), de ahí horaInicio/horaFin.
model TurnoComedor {
  id         Int      @id @default(autoincrement())
  nombre     String   @unique
  horaInicio DateTime @db.Time
  horaFin    DateTime @db.Time
  createdAt  DateTime @default(now())

  inscripciones InscripcionComedor[]
}

// ---- Inscripciones a Deportes / Transporte / Comedor (RF-18 a RF-22) ----

// Denormaliza deporteId (además de grupoDeporteId) a propósito: el TP dice
// "2 deportes" (no "2 grupos"), así que el tope de 2 y el rechazo de
// duplicados deben calcularse por Deporte, no por Grupo. Con
// @@unique([estudianteId, deporteId]) la base garantiza sola, sin lógica
// adicional, que un alumno no pueda tener dos grupos activos del MISMO
// deporte (RF-22) y que contar sus filas alcance para el tope de 2 (RF-18)
// sin tener que hacer join ni distinct.
model InscripcionDeporte {
  id             Int          @id @default(autoincrement())
  estudianteId   Int
  estudiante     User         @relation("InscripcionesDeporte", fields: [estudianteId], references: [id], onDelete: Cascade)
  deporteId      Int
  deporte        Deporte      @relation(fields: [deporteId], references: [id], onDelete: Restrict)
  grupoDeporteId Int
  grupoDeporte   GrupoDeporte @relation(fields: [grupoDeporteId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([estudianteId, deporteId])
  @@index([grupoDeporteId])
}

// @unique(estudianteId): "1 de los 4 recorridos" (RF-19) se modela como
// estado ACTUAL (a lo sumo una fila por alumno), no como historial
// mensual — el TP no pide reportar variaciones mes a mes, solo permitir
// que el alumno CAMBIE de recorrido ("puede variar mes a mes" = se puede
// reemplazar, no que haya que guardar cada mes). Cambiar de recorrido es
// un upsert, nunca puede haber una fila duplicada (RF-22 queda resuelto
// por el propio @unique).
model InscripcionTransporte {
  id           Int                 @id @default(autoincrement())
  estudianteId Int                 @unique
  estudiante   User                @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  recorridoId  Int
  recorrido    RecorridoTransporte @relation(fields: [recorridoId], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// Mismo criterio que InscripcionTransporte.
model InscripcionComedor {
  id           Int          @id @default(autoincrement())
  estudianteId Int          @unique
  estudiante   User         @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  turnoId      Int
  turno        TurnoComedor @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
