// Educar para Transformar — Campus virtual
// Schema con auth, calificaciones, vínculo padre-hijo, asistencia,
// notificaciones, foros y planes de estudio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ESTUDIANTE
  DOCENTE
  PADRE
  ADMIN
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  TARDE
  JUSTIFICADO
}

enum ModerationStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model User {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique
  email     String   @unique
  dni       String   @unique
  password  String
  role      Role
  nombre    String
  curso     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  notasRecibidas Grade[]             @relation("EstudianteGrades")
  notasDadas     Grade[]             @relation("DocenteGrades")
  hijos          ParentStudentLink[] @relation("PadreLinks")
  padres         ParentStudentLink[] @relation("EstudianteLinks")

  asistencias           Attendance[]
  notificaciones        Notification[]
  planesDeEstudio       StudyPlan[]
  forumPosts            ForumPost[]
  forumReplies          ForumReply[]

  @@index([role])
}

model Grade {
  id           Int      @id @default(autoincrement())
  estudianteId Int
  estudiante   User     @relation("EstudianteGrades", fields: [estudianteId], references: [id], onDelete: Cascade)
  docenteId    Int
  docente      User     @relation("DocenteGrades", fields: [docenteId], references: [id], onDelete: Restrict)
  materia      String
  instancia    String
  nota         Int
  fecha        DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([estudianteId])
  @@index([docenteId])
}

model ParentStudentLink {
  id           Int  @id @default(autoincrement())
  padreId      Int
  padre        User @relation("PadreLinks", fields: [padreId], references: [id], onDelete: Cascade)
  estudianteId Int
  estudiante   User @relation("EstudianteLinks", fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([padreId, estudianteId])
  @@index([estudianteId])
}

model Attendance {
  id           Int              @id @default(autoincrement())
  estudianteId Int
  estudiante   User             @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  fecha        DateTime         @db.Date
  status       AttendanceStatus
  materia      String?
  observacion  String?
  createdAt    DateTime         @default(now())

  @@unique([estudianteId, fecha, materia])
  @@index([estudianteId])
  @@index([fecha])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo    String
  contenido String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ForumPost {
  id        Int          @id @default(autoincrement())
  authorId  Int
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  materia   String
  titulo    String
  contenido String
  isPinned  Boolean      @default(false)
  createdAt DateTime     @default(now())

  replies   ForumReply[]

  @@index([materia])
  @@index([createdAt])
}

model ForumReply {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  contenido String
  createdAt DateTime  @default(now())

  @@index([postId])
}

model Inscription {
  id              Int              @id @default(autoincrement())
  nombreTutor     String
  emailTutor      String
  telefonoTutor   String
  nombreEstudiante String
  nivel           String
  curso           String
  mensaje         String?
  status          ModerationStatus @default(PENDIENTE)
  notaAdmin       String?
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?

  @@index([status])
  @@index([createdAt])
}

model Opinion {
  id        Int              @id @default(autoincrement())
  nombre    String?
  rol       String
  texto     String
  rating    Int
  status    ModerationStatus @default(PENDIENTE)
  createdAt DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model EmploymentApplication {
  id        Int              @id @default(autoincrement())
  nombre    String
  email     String
  puesto    String
  cvUrl     String?
  status    ModerationStatus @default(PENDIENTE)
  notaAdmin String?
  createdAt DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model StudyPlan {
  id         Int      @id @default(autoincrement())
  docenteId  Int
  docente    User     @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  materia    String
  titulo     String
  objetivos  String
  contenidos String
  fileUrl    String?
  createdAt  DateTime @default(now())

  @@index([materia])
}
