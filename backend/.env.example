# ==============================================
# Backend — Educar para Transformar
# Copia este archivo a `.env` y completa los valores reales.
# `.env` está gitignoreado.
# ==============================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto donde escucha la API
PORT=4000

# Orígenes permitidos por CORS (URL del frontend en dev). Se pueden poner
# varios separados por coma, ej. http://localhost:5173,http://localhost:8081
# (el segundo es Expo web). La app nativa no necesita figurar acá.
CORS_ORIGIN=http://localhost:5173

# ---------- Base de datos ----------
# Reemplazá USER, PASSWORD y DBNAME según tu instalación local.
# Si usás el superusuario que creaste durante la instalación de PostgreSQL:
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/educar_transformar_db?schema=public

# ---------- JWT ----------
# Generá secretos largos y aleatorios (>= 32 caracteres).
# Ej: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-distinto
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=24h

# ---------- Uploads ----------
# Tamaño máximo por archivo, en megabytes
MAX_UPLOAD_SIZE_MB=20

# ---------- Cloudinary (storage externo para archivos subidos) ----------
# Los archivos subidos (CVs, galería, planes de estudio) se guardan en
# Cloudinary en vez del disco local, porque el hosting free de Render no
# tiene disco persistente (se pierde todo en cada deploy/reinicio).
# Creá una cuenta free en https://cloudinary.com (sin tarjeta) y completá
# estos 3 valores con los del dashboard ("API Keys").
CLOUDINARY_CLOUD_NAME=cambiar
CLOUDINARY_API_KEY=cambiar
CLOUDINARY_API_SECRET=cambiar

# ---------- Comprobantes de transferencia (Parte 3, opcional) ----------
# Driver de almacenamiento privado: cloudinary | local. Sin cargar:
# producción → cloudinary; desarrollo → cloudinary si CLOUDINARY_CLOUD_NAME
# está cargado, si no → local (backend/storage-privado/, gitignoreado);
# tests → memoria. "local" nunca se usa en producción.
# STORAGE_DRIVER=local

# ---------- Datos bancarios del colegio (Parte 3, opcionales) ----------
# Se muestran en la factura en PDF y en el comprobante de pago: solo se
# aceptan transferencias. Si no se cargan, se usan estos valores ficticios.
BANCO_TITULAR=Educar para Transformar S.A.
BANCO_CUIT=30-71234567-8
BANCO_CBU=0000003100012345678901
BANCO_ALIAS=EDUCAR.TRANSFORMAR.CUOTAS

# ---------- Mails (Parte 3, HU9, opcionales) ----------
# Render free bloquea el SMTP: los mails salen por la API de Resend.
# Sin RESEND_API_KEY no se manda nada: el mail completo queda en el log
# (útil para desarrollar). En los tests nunca se usa el proveedor.
# RESEND_API_KEY=re_xxxxxxxx
# Sin dominio propio verificado, Resend solo entrega a la casilla de la
# cuenta: MAIL_REDIRECT_TO manda todos los mails ahí.
# MAIL_REDIRECT_TO=casilla-del-equipo@gmail.com
# MAIL_FROM=Educar para Transformar <onboarding@resend.dev>

# ---------- Jobs diarios (Parte 3, HU9, opcional) ----------
# Protege POST /api/jobs/diario (lo llama .github/workflows/jobs-diarios.yml).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
